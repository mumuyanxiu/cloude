{
  "name": "cloude",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cloude desktop workspace powered by Paseo for Claude Code and Codex",
  "repository": {
    "type": "git",
    "url": "https://github.com/mumuyanxiu/cloude.git"
  },
  "author": "Cloude contributors",
  "main": "electron/launcher.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:legacy && npm run build:paseo",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/test-desktop.cjs",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never && node scripts/release-checksums.cjs",
    "verify:privacy": "node scripts/check-privacy.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "build:legacy": "tsc --noEmit && vite build",
    "build:paseo": "node scripts/prepare-paseo.cjs",
    "start:legacy": "electron . --legacy",
    "test:paseo": "node tests/paseo-flow.cjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@uiw/react-codemirror": "^4.25.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.1.0",
    "electron-builder": "^26.0.12",
    "tar": "7.5.22",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "io.github.cloudclaude.desktop",
    "productName": "Cloude",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "assets/claude-icon.png"
    },
    "nsis": {
      "artifactName": "Cloude-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "deleteAppDataOnUninstall": false,
      "include": "scripts/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mumuyanxiu",
        "repo": "cloude",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "runtime/paseo",
        "to": "paseo",
        "filter": [
          "**/*",
          "!**/*.map",
          "!node_modules/**/*"
        ]
      },
      {
        "from": "runtime/paseo/node_modules",
        "to": "paseo/node_modules",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ]
  }
}
